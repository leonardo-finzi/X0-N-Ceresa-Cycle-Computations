// Computes an AL invariant/anti-invariant basis for S2(N)
function ALBasis(N, p, prec)
	S := CuspForms(N);
	B := Basis(S, prec);
	M := AtkinLehnerOperator(S, p);
	spc1 := Kernel(M - ScalarMatrix(#B, 1));
	spc2 := Kernel(M + ScalarMatrix(#B, 1));
	b1s := Basis(spc1);
	b2s := Basis(spc2);

	basis1 := [];
	for b in b1s do
		f := 0;
		for i := 1 to #B do
			f := f + b[i] * B[i];
		end for;
		Append(~basis1, f);
	end for;
	
	basis2 := [];
	for b in b2s do
		f := 0;
		for i := 1 to #B do
			f := f + b[i] * B[i];
		end for;
		Append(~basis2, f);
	end for;

	return basis1, basis2;
end function;

// Computes the Sturm bound of any modular form at level N with weight k
function SturmBound(N,k);
	G := Gamma0(N);
	m := Index(G);
	sturm := Floor((k*m) div 12);
	return sturm;
end function;

// Computes Q_d for d a positive integer
function DefiningIdeal(d,sturm,Qx,basis)
	mons := MonomialsOfDegree(Qx,d);
	
	V := VectorSpace(Rationals(),#mons);
	monImages:=[Evaluate(mon,basis) : mon in mons];

	W := VectorSpace(Rationals(),sturm);
	monImages := [W![Coefficient(m,i) : i in [0..sturm-1] ] : m in monImages];

	h := hom<V->W | monImages>;

	K := Kernel(h);
	K := Basis(K);
	v := [ Eltseq(V!(K[i])): i in [1..#K]];

	Q := [ &+[a[i]*mons[i] : i in [1..#mons]] : a in v ];    // quadric/cubic/etc. cutting out our curve in P^g-1
	Q := [f * LCM([Denominator(c) : c in Coefficients(f)]) : f in Q];
	return Q;
end function;

// Computes the order of the shadow of w_N mod coprime (coprime has good reduction)
function ProjModelChecker(N,coprime)
	G := Gamma0(N);
	g := Genus(G);
	// This bound is selected because it is the largest value for which q-expansions can be distinguished (with some extra room just in case).
	sturm := SturmBound(N,6) + 10;
	
	Qq<q> := PowerSeriesRing(Rationals(),sturm);

	basis1, basis2 := ALBasis(N,N,sturm) ;
	basis := basis1 cat basis2 ;
	n := #basis;
	
	// Basis check
	if (#basis1 eq 0) or (#basis2 eq 0) then
		return "Bad basis";
	end if;

	Qx<[x]> := PolynomialRing(Rationals(),n);
	Zx<[x]> := PolynomialRing(Integers(), #basis);
	
	Q2 := DefiningIdeal(2,sturm,Qx,basis);
	Q3 := DefiningIdeal(3,sturm,Qx,basis);
  Q4 := DefiningIdeal(4,sturm,Qx,basis);
	
	Zx<[x]> := PolynomialRing(GF(coprime), #basis);
	P := ProjectiveSpace(Zx);
	
	// quadric base change to GF(coprime)
	Qmod2 := [ Zx ! f : f in Q2];
	C2 := Scheme(P, Qmod2);
	
	// cubic base change to GF(coprime)
	Qmod3 := [ Zx ! f : f in Q3];
	C3 := Scheme(P,Qmod3);

  // quartic base change to GF(coprime)
	Qmod4 := [ Zx ! f : f in Q4];
	C4 := Scheme(P,Qmod4);

  // defining the canonical curve
	if Dimension(C2) eq 1 then
		C := Curve(C2);
	else
		C := Intersection(C2,C3);
		if Dimension(C) eq 1 then
			C := Curve(C);
		else
			C := Intersection(Intersection(C2,C3),C4);
		end if;
	end if;
	
	coordinates1 := [];
	for i in [1..#basis1] do
		Append(~coordinates1, x[i]);
	end for;

	I1 := Ideal(coordinates1) ;
	D1 := Divisor(C,I1);

	coordinates2 := [];
	for i in [#basis1 + 1..#basis] do
		Append(~coordinates2, x[i]);
	end for;

	I2 := Ideal(coordinates2);
	D2 := Divisor(C,I2);

	D := D1 + D2 ;

	Cl, phi, psi := ClassGroup(C);

	K := CanonicalDivisor(C);

	// Recall that (1/2)Sh(w121) = (g-1)D - (1/2)deg(D)K.
	T := (g-1)*D -(Degree(D) div 2)*K;
	print "The order of the shadow mod", coprime, "is:";
	return Order(psi(T));

end function;
